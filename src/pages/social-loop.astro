---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='8' fill='%23d9d9d9'/%3E%3C/svg%3E"
    />
    <title>CoAssembly Social Loop Maker</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #efefef;
        --panel: #ffffff;
        --ink: #111111;
        --line: #cbcbcb;
        --accent: #0f4c81;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        font-family: "Avenir Next", "Helvetica Neue", "Segoe UI", sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at 80% -20%, #f9d8a0 0%, transparent 46%),
          radial-gradient(circle at 6% 110%, #d2f0ff 0%, transparent 40%),
          var(--bg);
      }

      .app {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(360px, 1fr) 360px;
        gap: 1rem;
        padding: 1rem;
      }

      .stage-wrap,
      .panel {
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 14px;
      }

      .stage-wrap {
        display: grid;
        place-items: center;
        padding: 1rem;
      }

      .stage {
        width: min(100%, calc((100vh - 4rem) * (1080 / 1350)));
        max-height: calc(100vh - 4rem);
        aspect-ratio: 1080 / 1350;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        background: transparent;
      }

      #outputCanvas {
        width: 100%;
        height: 100%;
        display: block;
      }

      .panel {
        padding: 0.9rem;
        overflow: auto;
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .hint {
        margin: 0 0 1rem;
        font-size: 0.82rem;
        line-height: 1.35;
        opacity: 0.75;
      }

      .group {
        border-top: 1px solid var(--line);
        padding-top: 0.8rem;
        margin-top: 0.8rem;
      }

      label {
        display: block;
        margin-bottom: 0.15rem;
        font-size: 0.77rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      input[type="range"],
      input[type="number"],
      input[type="file"],
      button {
        width: 100%;
      }

      input[type="range"] {
        accent-color: var(--accent);
      }

      .row {
        margin-bottom: 0.55rem;
      }

      .value {
        float: right;
        font-variant-numeric: tabular-nums;
        opacity: 0.85;
      }

      button {
        border: 1px solid var(--ink);
        border-radius: 8px;
        padding: 0.6rem 0.7rem;
        font-size: 0.84rem;
        background: #fff;
        cursor: pointer;
      }

      button.primary {
        background: var(--ink);
        color: #fff;
      }

      button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .small {
        margin-top: 0.55rem;
        font-size: 0.74rem;
        line-height: 1.3;
        opacity: 0.78;
      }

      @media (max-width: 980px) {
        .app {
          grid-template-columns: 1fr;
        }

        .stage {
          width: min(100%, 560px);
          max-height: unset;
        }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <section class="stage-wrap">
        <div class="stage">
          <canvas id="outputCanvas" width="1080" height="1350"></canvas>
        </div>
      </section>

      <aside class="panel">
        <h1>Social Loop Maker</h1>
        <p class="hint">
          1080x1350 output. Upload a background, pick a scene, tune motion, then
          export one perfect loop.
        </p>

        <div class="group">
          <div class="row">
            <label for="sceneMode"
              >Scene
              <span id="sceneModeOut" class="value">Chairs</span></label
            >
            <input
              id="sceneMode"
              type="range"
              min="0"
              max="1"
              step="1"
              value="1"
            />
          </div>
        </div>

        <div class="group">
          <div class="row">
            <label for="bgUpload">Background Image</label>
            <input id="bgUpload" type="file" accept="image/*" />
          </div>
          <div class="row">
            <label for="bgFit"
              >Image Fit
              <span id="bgFitOut" class="value">Contain</span></label
            >
            <input id="bgFit" type="range" min="0" max="2" step="1" value="0" />
          </div>
          <div class="row">
            <label for="bgMode"
              >No-image Background
              <span id="bgModeOut" class="value">Transparent</span></label
            >
            <input
              id="bgMode"
              type="range"
              min="0"
              max="1"
              step="1"
              value="1"
            />
          </div>
          <div class="row">
            <button id="clearBg" type="button">Clear Background</button>
          </div>
        </div>

        <div class="group">
          <div class="row">
            <label for="loopSeconds"
              >Loop Length
              <span id="loopSecondsOut" class="value">8.0s</span></label
            >
            <input
              id="loopSeconds"
              type="range"
              min="2"
              max="20"
              step="0.5"
              value="8"
            />
          </div>
        </div>

        <div class="group">
          <div class="row">
            <label for="spinX"
              >Spin X (revs/loop)
              <span id="spinXOut" class="value">1.0</span></label
            >
            <input
              id="spinX"
              type="range"
              min="-6"
              max="6"
              step="0.1"
              value="1"
            />
          </div>
          <div class="row">
            <label for="spinY"
              >Spin Y (revs/loop)
              <span id="spinYOut" class="value">-1.0</span></label
            >
            <input
              id="spinY"
              type="range"
              min="-6"
              max="6"
              step="0.1"
              value="-1"
            />
          </div>
          <div class="row">
            <label for="spinZ"
              >Spin Z (revs/loop)
              <span id="spinZOut" class="value">2.0</span></label
            >
            <input
              id="spinZ"
              type="range"
              min="-8"
              max="8"
              step="0.1"
              value="2"
            />
          </div>
        </div>

        <div class="group">
          <div class="row">
            <label for="size"
              >Asterisk Size
              <span id="sizeOut" class="value">0.62</span></label
            >
            <input
              id="size"
              type="range"
              min="0.2"
              max="1.2"
              step="0.01"
              value="0.62"
            />
          </div>
          <div class="row">
            <label for="posX"
              >Position X (px)
              <span id="posXOut" class="value">0</span></label
            >
            <input
              id="posX"
              type="range"
              min="-540"
              max="540"
              step="1"
              value="0"
            />
          </div>
          <div class="row">
            <label for="posY"
              >Position Y (px)
              <span id="posYOut" class="value">0</span></label
            >
            <input
              id="posY"
              type="range"
              min="-675"
              max="675"
              step="1"
              value="0"
            />
          </div>
        </div>

        <div class="group">
          <div class="row">
            <button id="exportBtn" class="primary" type="button">
              Export MP4
            </button>
          </div>
          <p id="status" class="small">Ready.</p>
          <p class="small">
            Exports MP4. If your browser cannot record MP4 directly, it will
            record WebM first and convert to MP4 automatically.
          </p>
        </div>
      </aside>
    </main>

    <script>
      import * as THREE from "three";

      const WIDTH = 1080;
      const HEIGHT = 1350;
      const FOV = 35;
      const CAMERA_Z = 12;

      const outputCanvas = document.getElementById("outputCanvas");
      const outputCtx = outputCanvas.getContext("2d", { alpha: true });

      const ui = {
        sceneMode: document.getElementById("sceneMode"),
        bgUpload: document.getElementById("bgUpload"),
        bgFit: document.getElementById("bgFit"),
        bgMode: document.getElementById("bgMode"),
        clearBg: document.getElementById("clearBg"),
        loopSeconds: document.getElementById("loopSeconds"),
        spinX: document.getElementById("spinX"),
        spinY: document.getElementById("spinY"),
        spinZ: document.getElementById("spinZ"),
        size: document.getElementById("size"),
        posX: document.getElementById("posX"),
        posY: document.getElementById("posY"),
        exportBtn: document.getElementById("exportBtn"),
        status: document.getElementById("status"),
        loopSecondsOut: document.getElementById("loopSecondsOut"),
        spinXOut: document.getElementById("spinXOut"),
        spinYOut: document.getElementById("spinYOut"),
        spinZOut: document.getElementById("spinZOut"),
        sizeOut: document.getElementById("sizeOut"),
        posXOut: document.getElementById("posXOut"),
        posYOut: document.getElementById("posYOut"),
        bgFitOut: document.getElementById("bgFitOut"),
        bgModeOut: document.getElementById("bgModeOut"),
        sceneModeOut: document.getElementById("sceneModeOut"),
      };

      const state = {
        sceneMode: "chairs",
        loopSeconds: 8,
        spinX: 1,
        spinY: -1,
        spinZ: 2,
        size: 0.62,
        posX: 0,
        posY: 0,
        bgImage: null,
        bgFit: "contain",
        bgMode: "transparent",
        exportOriginMs: null,
      };

      const ffmpegState = {
        ffmpeg: null,
        loaded: false,
        loading: false,
      };

      const BG_FIT_LABELS = {
        contain: "Contain",
        cover: "Cover",
        stretch: "Stretch",
      };

      const SCENE_MODE_LABELS = {
        asterisk: "Asterisk",
        chairs: "Chairs",
      };

      function updateReadouts() {
        ui.loopSecondsOut.textContent = `${state.loopSeconds.toFixed(1)}s`;
        ui.spinXOut.textContent = state.spinX.toFixed(1);
        ui.spinYOut.textContent = state.spinY.toFixed(1);
        ui.spinZOut.textContent = state.spinZ.toFixed(1);
        ui.sizeOut.textContent = state.size.toFixed(2);
        ui.posXOut.textContent = `${Math.round(state.posX)}`;
        ui.posYOut.textContent = `${Math.round(state.posY)}`;
        ui.bgFitOut.textContent = BG_FIT_LABELS[state.bgFit];
        ui.bgModeOut.textContent =
          state.bgMode === "transparent" ? "Transparent" : "#D9D9D9";
        ui.sceneModeOut.textContent = SCENE_MODE_LABELS[state.sceneMode];
      }

      function bindRange(input, key, parser) {
        input.addEventListener("input", () => {
          state[key] = parser(input.value);
          updateReadouts();
        });
      }

      bindRange(ui.loopSeconds, "loopSeconds", Number.parseFloat);
      bindRange(ui.spinX, "spinX", Number.parseFloat);
      bindRange(ui.spinY, "spinY", Number.parseFloat);
      bindRange(ui.spinZ, "spinZ", Number.parseFloat);
      bindRange(ui.size, "size", Number.parseFloat);
      bindRange(ui.posX, "posX", Number.parseFloat);
      bindRange(ui.posY, "posY", Number.parseFloat);

      ui.bgFit.addEventListener("input", () => {
        const mode = Number.parseInt(ui.bgFit.value, 10);
        if (mode === 1) state.bgFit = "cover";
        else if (mode === 2) state.bgFit = "stretch";
        else state.bgFit = "contain";
        updateReadouts();
      });

      ui.sceneMode.addEventListener("input", () => {
        state.sceneMode = ui.sceneMode.value === "0" ? "asterisk" : "chairs";
        updateReadouts();
      });

      ui.bgMode.addEventListener("input", () => {
        state.bgMode = ui.bgMode.value === "1" ? "transparent" : "solid";
        updateReadouts();
      });

      ui.bgUpload.addEventListener("change", async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        const dataUrl = await fileToDataUrl(file);
        const img = new Image();
        img.src = dataUrl;
        await img.decode();
        state.bgImage = img;
        ui.status.textContent = `Background loaded: ${file.name}`;
      });

      ui.clearBg.addEventListener("click", () => {
        ui.bgUpload.value = "";
        state.bgImage = null;
        ui.status.textContent = "Background cleared.";
      });

      function fileToDataUrl(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result));
          reader.onerror = () => reject(reader.error);
          reader.readAsDataURL(file);
        });
      }

      function drawBackground(ctx) {
        if (!state.bgImage) {
          if (state.bgMode === "transparent") {
            ctx.clearRect(0, 0, WIDTH, HEIGHT);
          } else {
            ctx.fillStyle = "#d9d9d9";
            ctx.fillRect(0, 0, WIDTH, HEIGHT);
          }
          return;
        }

        const img = state.bgImage;
        if (state.bgFit === "stretch") {
          ctx.drawImage(img, 0, 0, WIDTH, HEIGHT);
          return;
        }

        const useCover = state.bgFit === "cover";
        const scale = useCover
          ? Math.max(WIDTH / img.width, HEIGHT / img.height)
          : Math.min(WIDTH / img.width, HEIGHT / img.height);
        const drawW = img.width * scale;
        const drawH = img.height * scale;
        const dx = (WIDTH - drawW) / 2;
        const dy = (HEIGHT - drawH) / 2;
        ctx.drawImage(img, dx, dy, drawW, drawH);
      }

      const renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setClearColor(0x000000, 0);
      renderer.setSize(WIDTH, HEIGHT, false);
      renderer.setPixelRatio(1);
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      const glCanvas = renderer.domElement;
      glCanvas.width = WIDTH;
      glCanvas.height = HEIGHT;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(
        FOV,
        WIDTH / HEIGHT,
        0.1,
        5000,
      );
      camera.position.set(0, 0, CAMERA_Z);

      const material = new THREE.MeshStandardMaterial({
        color: 0x111111,
        metalness: 0.1,
        roughness: 0.42,
      });

      const len = 5.4;
      const thick = 0.42;
      const depth = 0.42;
      const cornerR = 0.208;
      const hl = len / 2;
      const ht = thick / 2;
      const r = Math.min(cornerR, ht - 0.001);
      const asteriskShape = new THREE.Shape();
      asteriskShape.moveTo(-hl + r, -ht);
      asteriskShape.lineTo(hl - r, -ht);
      asteriskShape.quadraticCurveTo(hl, -ht, hl, -ht + r);
      asteriskShape.lineTo(hl, ht - r);
      asteriskShape.quadraticCurveTo(hl, ht, hl - r, ht);
      asteriskShape.lineTo(-hl + r, ht);
      asteriskShape.quadraticCurveTo(-hl, ht, -hl, ht - r);
      asteriskShape.lineTo(-hl, -ht + r);
      asteriskShape.quadraticCurveTo(-hl, -ht, -hl + r, -ht);
      asteriskShape.closePath();

      const asteriskGeom = new THREE.ExtrudeGeometry(asteriskShape, {
        steps: 1,
        depth,
        bevelEnabled: true,
        bevelThickness: 0.205,
        bevelSize: 0.205,
        bevelOffset: 0,
        bevelSegments: 14,
        curveSegments: 28,
      });
      asteriskGeom.translate(0, 0, -depth / 2);

      const group = new THREE.Group();
      for (let i = 0; i < 3; i++) {
        const arm = new THREE.Mesh(asteriskGeom, material);
        arm.rotation.z = (Math.PI / 3) * i;
        group.add(arm);
      }
      scene.add(group);

      const chairsGroup = new THREE.Group();
      chairsGroup.position.y = 0.9;
      scene.add(chairsGroup);

      const CHAIR_COUNT = 5;
      const CHAIR_GAP = 250;
      const chairParams = Array.from({ length: CHAIR_COUNT }, () => ({
        seatW: THREE.MathUtils.randFloat(60, 100),
        seatD: THREE.MathUtils.randFloat(80, 160),
        seatH: 12,
        backH: THREE.MathUtils.randFloat(70, 110),
        legH: THREE.MathUtils.randFloat(60, 120),
        legW: 10,
      }));

      function createChair(chair) {
        const chairRoot = new THREE.Group();
        const mat = new THREE.MeshStandardMaterial({
          color: 0x000000,
          metalness: 0.12,
          roughness: 0.58,
        });

        const seat = new THREE.Mesh(
          new THREE.BoxGeometry(chair.seatW, chair.seatH, chair.seatD),
          mat,
        );
        seat.position.set(0, chair.seatH / 2, 0);
        chairRoot.add(seat);

        const back = new THREE.Mesh(
          new THREE.BoxGeometry(chair.seatW, chair.backH, 6),
          mat,
        );
        back.position.set(
          0,
          chair.seatH + chair.backH / 2,
          chair.seatD / 2 - 3,
        );
        chairRoot.add(back);

        const lx = chair.seatW / 2 - 5;
        const lz = chair.seatD / 2 - 5;
        const legGeom = new THREE.BoxGeometry(
          chair.legW,
          chair.legH,
          chair.legW,
        );

        const legPositions = [
          [-lx, -chair.legH / 2, -lz],
          [lx, -chair.legH / 2, -lz],
          [-lx, -chair.legH / 2, lz],
          [lx, -chair.legH / 2, lz],
        ];

        for (const [x, y, z] of legPositions) {
          const leg = new THREE.Mesh(legGeom, mat);
          leg.position.set(x, y, z);
          chairRoot.add(leg);
        }

        return chairRoot;
      }

      const chairMeshes = chairParams.map((params) => {
        const chair = createChair(params);
        chair.userData.params = params;
        chairsGroup.add(chair);
        return chair;
      });

      const key = new THREE.DirectionalLight(0xffffff, 1.2);
      key.position.set(-4, 5, 6);
      scene.add(key);
      const fill = new THREE.DirectionalLight(0x99bbff, 0.45);
      fill.position.set(4, -2, 3);
      scene.add(fill);
      const ambient = new THREE.AmbientLight(0xffffff, 0.35);
      scene.add(ambient);

      const baseDiameter = len + 2 * 0.205;

      function fitGroup() {
        const fovRad = (FOV * Math.PI) / 180;
        const visH = 2 * CAMERA_Z * Math.tan(fovRad / 2);
        const visW = visH * (WIDTH / HEIGHT);
        const minVis = Math.min(visH, visW);

        const targetSize = minVis * state.size;
        group.scale.setScalar(targetSize / baseDiameter);

        group.position.x = (state.posX / WIDTH) * visW;
        group.position.y = (-state.posY / HEIGHT) * visH;
      }

      function loopTime(nowMs) {
        if (state.exportOriginMs != null) {
          return ((nowMs - state.exportOriginMs) / 1000) % state.loopSeconds;
        }
        return (
          (((nowMs / 1000) % state.loopSeconds) + state.loopSeconds) %
          state.loopSeconds
        );
      }

      function renderAsterisk(p) {
        group.visible = true;
        chairsGroup.visible = false;
        camera.position.set(0, 0, CAMERA_Z);
        camera.lookAt(0, 0, 0);

        fitGroup();
        group.rotation.x = -0.2 + 2 * Math.PI * state.spinX * p;
        group.rotation.y = 0.2 + 2 * Math.PI * state.spinY * p;
        group.rotation.z = 2 * Math.PI * state.spinZ * p;
      }

      function renderChairs(t) {
        group.visible = false;
        chairsGroup.visible = true;

        const total = chairMeshes.length;
        const radius = (CHAIR_GAP * total) / (2 * Math.PI);
        const centerY =
          chairParams.reduce((acc, p) => acc + (p.legH + p.seatH * 0.5), 0) /
          total;
        const camRadius = Math.max(560, radius * 6);
        const camAngle = -1.8 + (t / state.loopSeconds) * 2 * Math.PI;
        const camX = camRadius * Math.cos(camAngle);
        const camZ = camRadius * Math.sin(camAngle);
        camera.position.set(camX, centerY + 120, camZ);
        camera.lookAt(0, centerY, 0);

        for (let i = 0; i < chairMeshes.length; i++) {
          const mesh = chairMeshes[i];
          const params = mesh.userData.params;
          const angle = (i / total) * 2 * Math.PI;
          const x = radius * Math.cos(angle);
          const z = radius * Math.sin(angle);
          const y = params.legH;

          mesh.position.set(x, y, z);
          mesh.rotation.set(0, Math.atan2(-x, -z) + Math.PI, 0);
        }
      }

      function renderFrame(nowMs) {
        const t = loopTime(nowMs);
        const p = t / state.loopSeconds;

        if (state.sceneMode === "chairs") {
          renderChairs(t);
        } else {
          renderAsterisk(p);
        }

        renderer.render(scene, camera);

        outputCtx.clearRect(0, 0, WIDTH, HEIGHT);
        drawBackground(outputCtx);
        outputCtx.drawImage(glCanvas, 0, 0, WIDTH, HEIGHT);
      }

      function animate(nowMs) {
        renderFrame(nowMs);
        requestAnimationFrame(animate);
      }

      const WEBM_MIME_OPTIONS = [
        "video/webm;codecs=vp9",
        "video/webm;codecs=vp8",
        "video/webm",
      ];

      const MP4_MIME_OPTIONS = [
        "video/mp4;codecs=avc1.42E01E,mp4a.40.2",
        "video/mp4;codecs=avc1.4D401F,mp4a.40.2",
        "video/mp4",
      ];

      function pickMimeType(options) {
        if (typeof MediaRecorder === "undefined") return "";
        for (const mime of options) {
          if (MediaRecorder.isTypeSupported(mime)) return mime;
        }
        return "";
      }

      async function ensureFfmpegLoaded() {
        if (ffmpegState.loaded) return ffmpegState.ffmpeg;
        if (ffmpegState.loading) {
          while (!ffmpegState.loaded) {
            await new Promise((resolve) => window.setTimeout(resolve, 80));
          }
          return ffmpegState.ffmpeg;
        }

        ffmpegState.loading = true;
        ui.status.textContent = "Loading MP4 converter...";

        try {
          const [{ FFmpeg }, { toBlobURL, fetchFile }] = await Promise.all([
            import("https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.10/dist/esm/index.js"),
            import("https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/esm/index.js"),
          ]);

          const baseURL =
            "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm";
          const ffmpeg = new FFmpeg();

          await ffmpeg.load({
            coreURL: await toBlobURL(
              `${baseURL}/ffmpeg-core.js`,
              "text/javascript",
            ),
            wasmURL: await toBlobURL(
              `${baseURL}/ffmpeg-core.wasm`,
              "application/wasm",
            ),
          });

          ffmpegState.ffmpeg = ffmpeg;
          ffmpegState.fetchFile = fetchFile;
          ffmpegState.loaded = true;
          return ffmpeg;
        } finally {
          ffmpegState.loading = false;
        }
      }

      async function recordLoopBlob(mimeType) {
        state.exportOriginMs = performance.now();

        const stream = outputCanvas.captureStream(60);
        const recorder = new MediaRecorder(stream, {
          mimeType,
          videoBitsPerSecond: 16_000_000,
        });
        const chunks = [];

        recorder.ondataavailable = (event) => {
          if (event.data && event.data.size > 0) chunks.push(event.data);
        };

        const stopped = new Promise((resolve) => {
          recorder.onstop = resolve;
        });

        recorder.start();

        await new Promise((resolve) => {
          window.setTimeout(resolve, Math.round(state.loopSeconds * 1000));
        });

        recorder.stop();
        await stopped;
        state.exportOriginMs = null;

        return new Blob(chunks, { type: mimeType });
      }

      async function transcodeWebmToMp4(webmBlob) {
        const ffmpeg = await ensureFfmpegLoaded();
        const inName = "input.webm";
        const outName = "output.mp4";

        await ffmpeg.writeFile(inName, await ffmpegState.fetchFile(webmBlob));
        await ffmpeg.exec([
          "-i",
          inName,
          "-c:v",
          "libx264",
          "-pix_fmt",
          "yuv420p",
          "-movflags",
          "+faststart",
          "-an",
          outName,
        ]);

        const data = await ffmpeg.readFile(outName);
        await ffmpeg.deleteFile(inName);
        await ffmpeg.deleteFile(outName);

        return new Blob([data.buffer], { type: "video/mp4" });
      }

      function downloadBlob(blob, extension) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        const stamp = new Date().toISOString().replace(/[:.]/g, "-");
        a.href = url;
        a.download = `coassembly-loop-${stamp}.${extension}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      async function exportLoopVideo() {
        if (typeof MediaRecorder === "undefined") {
          ui.status.textContent =
            "MediaRecorder is not available in this browser.";
          return;
        }

        const directMp4Mime = pickMimeType(MP4_MIME_OPTIONS);
        const webmMime = pickMimeType(WEBM_MIME_OPTIONS);

        if (!directMp4Mime && !webmMime) {
          ui.status.textContent =
            "No supported browser video encoder found for export.";
          return;
        }

        ui.exportBtn.disabled = true;
        try {
          if (directMp4Mime) {
            ui.status.textContent = "Recording MP4...";
            const mp4Blob = await recordLoopBlob(directMp4Mime);
            downloadBlob(mp4Blob, "mp4");
            ui.status.textContent = "MP4 export complete. Download started.";
            return;
          }

          ui.status.textContent = "Recording loop (WebM intermediate)...";
          const webmBlob = await recordLoopBlob(webmMime);
          ui.status.textContent = "Converting to MP4...";
          const mp4Blob = await transcodeWebmToMp4(webmBlob);
          downloadBlob(mp4Blob, "mp4");
          ui.status.textContent = "MP4 export complete. Download started.";
        } finally {
          state.exportOriginMs = null;
          ui.exportBtn.disabled = false;
        }
      }

      ui.exportBtn.addEventListener("click", () => {
        exportLoopVideo().catch((error) => {
          console.error(error);
          state.exportOriginMs = null;
          ui.exportBtn.disabled = false;
          ui.status.textContent = "Export failed. Check console for details.";
        });
      });

      updateReadouts();
      requestAnimationFrame(animate);
    </script>
  </body>
</html>
